# ============================================================
# WeatherGPT — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# For local development with SQLite (default, no setup needed):
# DATABASE_URL=sqlite+aiosqlite:///./weathergpt.db
# For PostgreSQL (Docker / production):
DATABASE_URL=postgresql+asyncpg://weathergpt:weathergpt@localhost:5432/weathergpt

# --- AI (Google Gemini) ---
# Get your key at: https://aistudio.google.com/app/apikey
# If left empty, WeatherGPT uses rule-based AI responses (all weather data still works)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Weather Provider ---
# Currently supported: open_meteo (free, no key needed)
WEATHER_PROVIDER=open_meteo

# --- Security ---
# CORS origins (comma-separated JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Rate Limiting ---
RATE_LIMIT=100/minute

# --- App ---
DEBUG=false

# --- Optional: Official Warning APIs ---
# IMD (India Meteorological Department) — no public API available yet
# Leave empty to show "not connected" message
# IMD_API_KEY=

# --- Optional: Secondary weather provider ---
# OPENWEATHER_API_KEY=
